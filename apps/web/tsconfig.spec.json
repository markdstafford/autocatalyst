{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc/apps/web-spec",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vitest"],
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test-helper.ts",
    "src/**/*.test-helper.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
